From a9799c1d0f6a98bf06da78c1eb05e4637c587632 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 21 Aug 2026 12:10:12 +0000
Subject: [PATCH] Fix ON ORDER undercounting: sum open_pos.qty_open instead of
 po_history.qty_ordered

po_history is sourced from a NetSuite report parser that silently drops PO
lines when the same item appears twice on a PO at different rates (e.g.
PO2402 for 127128*). It also stores the original ordered quantity, not the
remaining open quantity. open_pos is fed directly via SuiteQL with accurate
qty_open per line and was already being fetched but never used for this
calculation.

Verified against SuiteQL: 127128* has 4,720 units across 3 open PO lines
(292 + 4020 + 408); the site was showing 408.
---
 src/pages/ItemForecast.jsx | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/pages/ItemForecast.jsx b/src/pages/ItemForecast.jsx
index 10b6835..077b6e7 100644
--- a/src/pages/ItemForecast.jsx
+++ b/src/pages/ItemForecast.jsx
@@ -207,9 +207,13 @@ export function ItemForecast() {
     const portland = data.snap.on_hand_portland ?? 0;
     const hk = data.snap.on_hand_hk ?? 0;
     // Use the higher of: NetSuite snapshot on_order vs sum of active POs
-    const posOnOrder = (data.pos ?? [])
-      .filter(po => po.status?.includes('Pending') || po.status?.includes('Receipt'))
-      .reduce((sum, po) => sum + (po.qty_ordered ?? 0), 0);
+    // Sum from open_pos (accurate qty_open per line, fed by SuiteQL) instead of
+    // po_history (original qty_ordered, and known to drop multi-rate PO lines —
+    // see update_inventory.py create_po_history_sheet). This was the root cause
+    // of ON ORDER undercounting SKUs with multiple open PO lines (e.g. 127128*
+    // showed 408 instead of 4,720).
+    const posOnOrder = (data.openPos ?? [])
+      .reduce((sum, po) => sum + (po.qty_open ?? po.qty_ordered ?? 0), 0);
     const onOrderEffective = Math.max(data.snap.on_order ?? 0, posOnOrder);
     const coverage = a6 > 0 ? onHand / a6 : Infinity;
     const coveragePortland = a6 > 0 ? portland / a6 : Infinity;
